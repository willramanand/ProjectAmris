{
  "name": "@willramanand/amris",
  "version": "1.0.0",
  "type": "module",
  "description": "Amris web component library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willramanand/ProjectAmris.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/amris.js",
  "module": "./dist/amris.js",
  "types": "./dist/index.all.d.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.all.d.ts",
      "import": "./dist/amris.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/amris-core.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./styles/*": {
      "types": "./dist/styles/*.d.ts",
      "import": "./dist/styles/*.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./utilities/*": {
      "types": "./dist/utilities/*.d.ts",
      "import": "./dist/utilities/*.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/amris.js",
    "./dist/amris-core.js",
    "./dist/components/**/*.js",
    "./dist/chunks/**/*.js",
    "./dist/styles/*.js"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && tsc -p tsconfig.types.json && npm run build:manifest && npm run build:contract-doc && npm run build:tokens-css",
    "build:manifest": "cem analyze --config custom-elements-manifest.config.js",
    "build:contract-doc": "node scripts/build-contract-doc.mjs",
    "build:tokens-css": "node scripts/build-tokens-css.mjs",
    "diff:surface": "node scripts/cem-diff.mjs api/custom-elements.baseline.json dist/custom-elements.json",
    "smoke": "node scripts/smoke-pack.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "preview": "vite preview",
    "test": "vitest --project jsdom",
    "test:run": "vitest run",
    "test:coverage": "vitest run --project jsdom --coverage",
    "test:browser": "vitest run --project browser",
    "test:perf": "vitest run --project perf test/perf",
    "test:a11y": "vitest run test/a11y.test.ts",
    "size": "size-limit",
    "size:baseline": "node scripts/size-baseline.mjs",
    "size:why": "size-limit --why",
    "perf:diff": "node scripts/perf-diff.mjs api/perf.baseline.json api/perf.json",
    "assert:no-lit": "node scripts/assert-no-bundled-lit.mjs",
    "purity:check": "node scripts/deep-import-purity.mjs dist",
    "attribution:check": "node scripts/attribution-check.mjs",
    "visualize": "node scripts/visualize.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@lit-labs/virtualizer": "2.1.1",
    "@lit/context": "^1.1.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.6.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@size-limit/esbuild-why": "^13.0.3",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@storybook/web-components": "^10.3.0",
    "@storybook/web-components-vite": "^10.3.0",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "^4.1.0",
    "axe-core": "^4.11.1",
    "custom-elements-manifest": "^2.1.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.0.0",
    "playwright": "^1.62.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^13.0.3",
    "storybook": "^10.3.0",
    "tachometer": "^0.7.2",
    "terser": "^5.46.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "lit": "^3.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "rs-module-lexer@2.8.0": true
  }
}
